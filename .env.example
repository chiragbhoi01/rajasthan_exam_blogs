# ==========================================
# Rajasthan Exam Twister - Environment Configuration
# ==========================================

# Database Configuration (Existing CMS MongoDB)
MONGODB_URI=mongodb://localhost:27017/rajasthan_exam_twister
MONGODB_DB_NAME=rajasthan_exam_twister

# Cloudinary Media Configuration (for featured images & assets)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=rajasthan_exam_twister/blogs

# Automation Safety & Cost Controls
BLOG_AUTOMATION_ENABLED=true
BLOG_AUTOMATION_DRY_RUN=false
BLOG_AUTOMATION_SCHEDULE_ENABLED=false
BLOG_MAX_RESEARCH_SOURCES=8
BLOG_MAX_ARTICLE_WORDS=3000
DEFAULT_AUTHOR_NAME=Rajasthan Exam Twister Editorial Team

# Site URL for SEO and Internal Linking
SITE_BASE_URL=https://rajasthanexamtwister.in
